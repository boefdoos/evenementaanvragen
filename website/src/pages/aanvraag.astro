    </section>

    <!-- Stap 4 -->
    <section class="stap" data-stap="4" hidden>
      <h2 class="stap-h" tabindex="-1">Stap 4 van 5 · Plan, documenten en materiaal</h2>
      <fieldset id="inplanting">
