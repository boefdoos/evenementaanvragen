// ---- Termijncheck ----
// Zelfde rekenlogica en oordeel als de startpagina (rekenlogica.js, regels.json, indienmoment.js).
// Is de deadline van de gemeente (gekende termijn) voorbij, dan kan de aanvraag niet doorgestuurd worden.
let regelsGeladen = false, termijn = null;
const intakeForm = document.getElementById("intake");
function veld(n) { const el = intakeForm.elements[n]; return el ? (el.value || "") : ""; }

function berekenTermijn() {
  if (!regelsGeladen) return null;
  const gemNaam = veld("gemeente"), type = veld("type"), datum = veld("startdatum");
  if (!gemNaam || !type || !/^\d{4}-\d{2}-\d{2}$/.test(datum)) return null;
  const buiten = buitenAanbod(type, +veld("bezoekers") || 0);
  if (buiten) return { soort: "buiten", gemeente: gemNaam, reden: buiten };
  const r = RULES.find(x => x.gemeente === gemNaam);
  if (!r) return { soort: "onbekend", gemeente: gemNaam };
  const od = veld("openbaar_domein");
  const ev = { gem: r.gemeente, type, date: new Date(datum + "T00:00:00"), visitors: +veld("bezoekers") || 0, marge: 5,
    groot: false, nieuw: veld("eerste_editie") === "ja", od: od === "ja" || od === "deels", x: {} };
  let res = evaluate(r, ev);
  if (res.unknown) { const f = fallback(r, ev); if (!f) return { soort: "onbekend", gemeente: r.gemeente }; res = f; }
  const o = indienOordeel(res);
  // "Ten vroegste": aanvaardt de gemeente de evenementaanvraag pas vanaf een bepaalde datum?
  const NIET_AANVRAAG = /materiaal|uitleen|bord|affich|publici|wegwijz|bewegwijz|promo|lichtkrant|reserv|overspanning|toewijzing/i;
  const vr = (r.bijzonder || []).filter(b => b.soort === "vroegst" && b.n && /aanvraag|indien|toelating/i.test(b.wat) && !NIET_AANVRAAG.test(b.wat))
    .map(b => minus(ev.date, b.n, b.unit)).sort((a, b) => b - a)[0];
  const opent = vr && vr > today() ? vr : null;
  return { ...o, gemeente: r.gemeente, termijn: label(res.best.n, res.best.u), opent };
}

function toonTermijn() {
  termijn = berekenTermijn();
  const box = document.getElementById("termijn"), kop = document.getElementById("t-kop"), tekst = document.getElementById("t-tekst");
  if (!termijn) { box.hidden = true; zetBlokkade(false); return; }
  const t = termijn, d = t.deadline ? fmtLong(t.deadline) : "";
  let k, p;
  if (t.soort === "buiten") {
    k = "Niet in ons aanbod";
    p = t.reden + " Daarvoor kunnen we deze aanvraag niet opnemen.";
  } else if (t.soort === "laat") {
    k = "Te laat voor " + t.gemeente;
    p = "De deadline was " + d + " (" + t.termijn + " vooraf). We kunnen deze aanvraag niet meer op tijd indienen. Kies een latere datum als dat kan, of neem zelf contact op met de gemeente.";
  } else if (t.soort === "twijfel") {
    k = "Waarschijnlijk te laat";
    p = "De termijn van " + t.gemeente + " is niet zeker gekend. Volgens onze schatting is de deadline " + d + ", en die is al voorbij. Stuur toch door: we kijken het meteen na en laten het je weten.";
  } else if (t.soort === "krap") {
    k = "Krap, maar het kan nog";
    p = "Deadline bij " + t.gemeente + ": " + d + ". Stuur je aanvraag vandaag nog door, dan gaan we meteen aan de slag.";
  } else if (t.soort === "geschat") {
    k = "Waarschijnlijk op tijd";
    p = "Geschatte deadline bij " + t.gemeente + ": " + d + ". We kijken de termijn van deze gemeente meteen voor je na.";
  } else if (t.soort === "onbekend") {
    k = "Termijn nog niet gekend";
    p = "Voor " + t.gemeente + " kennen we de termijn nog niet. Stuur je aanvraag door, dan zoeken we hem meteen voor je op.";
  } else {
    k = "Op tijd";
    p = "Deadline bij " + t.gemeente + ": " + d + ". Ruim op tijd. Stuur je aanvraag door, dan gaan we meteen voor je aan de slag.";
  }
  if (t.opent && t.soort !== "laat" && t.soort !== "buiten") { k = "Je bent er vroeg bij"; p = t.gemeente + " aanvaardt aanvragen pas vanaf " + fmtLong(t.opent) + " (deadline " + d + "). Stuur gerust nu door: wij dienen in zodra het kan, jij hoeft niets meer te doen."; }
  box.className = "termijn " + t.soort; kop.textContent = k; tekst.textContent = p; box.hidden = false;
  zetBlokkade(t.soort === "laat" || t.soort === "buiten");
}

function zetBlokkade(aan) {
  const btn = document.getElementById("send"), st = document.getElementById("status");
  btn.classList.toggle("geblokkeerd", aan);
  btn.setAttribute("aria-disabled", aan ? "true" : "false");
  st.textContent = aan ? (termijn && termijn.soort === "buiten" ? "Doorsturen kan niet: dit valt niet in ons aanbod." : "Doorsturen kan niet: dit lukt niet meer voor de deadline van de gemeente.") : "";
}

