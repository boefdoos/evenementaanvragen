// ---- Termijncheck ----
// Zelfde rekenlogica en oordeel als de startpagina (rekenlogica.js, regels.json, indienmoment.js).
// Is de deadline van de gemeente (gekende termijn) voorbij, dan kan de aanvraag niet verder.
function berekenTermijn() {
  const gemNaam = veld("gemeente"), type = veld("type"), datum = veld("startdatum");
  // Buiten ons aanbod: meteen melden, ook als gemeente of datum nog niet gekozen zijn.
  const buiten = buitenAanbod(type, +veld("bezoekers") || 0);
  if (buiten) return { soort: "buiten", gemeente: gemNaam, reden: buiten };
  if (!regelsGeladen) return null;
  if (!gemNaam || !type || !/^\d{4}-\d{2}-\d{2}$/.test(datum)) return null;
  const r = RULES.find(x => x.gemeente === gemNaam);
  if (!r) return { soort: "onbekend", gemeente: gemNaam };
  const od = veld("openbaar_domein");
  const ev = { gem: r.gemeente, type, date: new Date(datum + "T00:00:00"), visitors: +veld("bezoekers") || 0, marge: 5,
    groot: false, nieuw: gekozen("eerste_editie") === "ja", od: od === "ja" || od === "deels", x: {} };
  let res = evaluate(r, ev);
  if (res.unknown) { const f = fallback(r, ev); if (!f) return { soort: "onbekend", gemeente: r.gemeente }; res = f; }
  const o = indienOordeel(res);
  // "Ten vroegste": aanvaardt de gemeente de evenementaanvraag pas vanaf een bepaalde datum?
  const NIET_AANVRAAG = /materiaal|uitleen|bord|affich|publici|wegwijz|bewegwijz|promo|lichtkrant|reserv|overspanning|toewijzing/i;
  const vr = (r.bijzonder || []).filter(b => b.soort === "vroegst" && b.n && /aanvraag|indien|toelating/i.test(b.wat) && !NIET_AANVRAAG.test(b.wat))
    .map(b => minus(ev.date, b.n, b.unit)).sort((a, b) => b - a)[0];
  const opent = vr && vr > today() ? vr : null;
  return { ...o, gemeente: r.gemeente, termijn: label(res.best.n, res.best.u), opent };
}

function toonTermijn() {
  termijn = berekenTermijn();
  const box = document.getElementById("termijn"), kop = document.getElementById("t-kop"), tekst = document.getElementById("t-tekst");
  if (!termijn) { box.hidden = true; zetBlokkade(false); toonGembox(); return; }
  const t = termijn, d = t.deadline ? fmtLong(t.deadline) : "";
  let k, p;
  if (t.soort === "buiten") {
    k = "Niet in ons aanbod";
    p = t.reden + " Daarvoor kunnen we deze aanvraag niet opnemen.";
  } else if (t.soort === "laat") {
    k = "Te laat voor " + t.gemeente;
    p = "De deadline was " + d + " (" + t.termijn + " vooraf). We kunnen deze aanvraag niet meer op tijd indienen. Kies een latere datum als dat kan, of neem zelf contact op met de gemeente.";
  } else if (t.soort === "twijfel") {
    k = "Waarschijnlijk te laat";
    p = "De termijn van " + t.gemeente + " is niet zeker gekend. Volgens onze schatting is de deadline " + d + ", en die is al voorbij. Ga toch verder: we kijken het meteen na en laten het je weten.";
  } else if (t.soort === "krap") {
    k = "Krap, maar het kan nog";
    p = "Deadline bij " + t.gemeente + ": " + d + ". Stuur je aanvraag vandaag nog door, dan gaan we meteen aan de slag.";
  } else if (t.soort === "geschat") {
    k = "Waarschijnlijk op tijd";
    p = "Geschatte deadline bij " + t.gemeente + ": " + d + ". We kijken de termijn van deze gemeente meteen voor je na.";
  } else if (t.soort === "onbekend") {
    k = "Termijn nog niet gekend";
    p = "Voor " + t.gemeente + " kennen we de termijn nog niet. Ga gerust verder, we zoeken hem meteen voor je op.";
  } else {
    k = "Op tijd";
    p = "Deadline bij " + t.gemeente + ": " + d + ". Ruim op tijd.";
  }
  if (t.opent && t.soort !== "laat" && t.soort !== "buiten") { k = "Je bent er vroeg bij"; p = t.gemeente + " aanvaardt aanvragen pas vanaf " + fmtLong(t.opent) + " (deadline " + d + "). Ga gerust verder: wij dienen in zodra het kan, jij hoeft niets meer te doen."; }
  box.className = "termijn " + t.soort; kop.textContent = k; tekst.textContent = p; box.hidden = false;
  zetBlokkade(t.soort === "laat" || t.soort === "buiten");
  toonGembox();
}

function zetBlokkade(aan) {
  const knoppen = [document.querySelector('.stap[data-stap="1"] .verder'), document.getElementById("send")];
  knoppen.forEach(b => { b.classList.toggle("geblokkeerd", aan); b.setAttribute("aria-disabled", aan ? "true" : "false"); });
  const tekst = aan ? (termijn && termijn.soort === "buiten" ? "Dit valt niet in ons aanbod." : "Dit lukt niet meer voor de deadline van de gemeente.") : "";
  document.getElementById("status1").textContent = tekst; document.getElementById("status").textContent = tekst;
}

["gemeente", "type", "startdatum", "bezoekers", "openbaar_domein", "eerste_editie", "locatie_soort", "aanvrager_type"].forEach(n => {
  intakeForm.querySelectorAll('[name="' + n + '"]').forEach(el => { el.addEventListener("change", () => { toonTermijn(); pasAan(); }); el.addEventListener("input", () => { toonTermijn(); pasAan(); }); });
});
const regelsKlaar = fetch("/regels.json").then(r => r.json()).then(data => { RULES = data; regelsGeladen = true; toonTermijn(); pasAan(); })
  .catch(() => { /* Lijst niet geladen: niet blokkeren, de termijn wordt dan bij de verwerking nagekeken. */ });
fetch("/plan/plannen.json").then(r => r.json()).then(d => { PLANNEN = d || {}; pasAan(); }).catch(() => {});

// Volmachttekst: zelfde sjabloon als in Code.gs (volmachtTekst). Bij wijzigen: beide aanpassen en VOLMACHT_VERSIE ophogen.
const VOLMACHTHEBBER = "Troostberg (ondernemingsnummer 0791.797.538), handelend onder de naam evenementaanvragen.be (thomas@evenementaanvragen.be)";
function datumNL(iso) {
  if (!iso) return "[datum]";
  return new Date(iso + "T12:00:00").toLocaleDateString("nl-BE", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
}
function volmachtTekst(d) {
  const v = x => String(d[x] || "").trim();
  const org = v("aanvrager_type") === "particulier" || !v("organisatie") ? "in eigen naam" : v("organisatie") + (v("ondernemingsnummer") ? ", ondernemingsnummer " + v("ondernemingsnummer") : "");
  return `Ondergetekende, ${v("volmacht_naam") || "[naam]"}, ${v("volmacht_functie") || "[hoedanigheid]"}, handelend ${org === "in eigen naam" ? "in eigen naam" : "namens " + org}${v("adres_organisator") ? ", " + v("adres_organisator") : ""},

geeft volmacht aan ${VOLMACHTHEBBER}

om in naam en voor rekening van de organisator de evenementaanvraag en de bijhorende aanvragen (zoals uitleenmateriaal) voor het evenement "${v("evenement_naam") || "[evenement]"}" op ${datumNL(v("startdatum"))} in ${v("gemeente") || "[gemeente]"} voor te bereiden en in te dienen bij de gemeente, via de kanalen die de gemeente daarvoor gebruikt.

De organisator blijft verantwoordelijk voor de juistheid van de gegevens, voor de organisatie van het evenement en voor de naleving van de vergunningsvoorwaarden. Na de indiening communiceert de gemeente rechtstreeks met de organisator. Deze volmacht geldt enkel voor dit evenement. Ze loopt tot 30 dagen na de indiening, zodat we een vraag van de gemeente over het ingediende dossier kunnen beantwoorden, en kan altijd ingetrokken worden met een mail aan thomas@evenementaanvragen.be.`;
}
const vt = document.getElementById("volmachttekst");
function toonVolmacht() { vt.textContent = volmachtTekst(Object.fromEntries(new FormData(intakeForm).entries())); }

// Prijs: zelfde regels als prijsVoor() in Betaling.gs. Plus = hulp bij het plan (plantekenaar) of 500 aanwezigen of meer.
function toonPrijs() {
  const box = document.getElementById("prijs");
  if (!veld("aanvrager_type") || !veld("bezoekers") || !veld("locatie_soort")) { box.hidden = true; return; }
  const p = prijsVoor();
  box.innerHTML = '<span>' + p.formule + (veld("aanvrager_type") === "bedrijf" ? ", tarief bedrijf of zelfstandige" : "") + '</span><b>€ ' + p.bedrag + '</b>';
  box.hidden = false;
}
function toonHerroeping() {
  const part = veld("aanvrager_type") === "particulier", w = document.getElementById("herroepwrap"), c = document.getElementById("herroeping");
  w.hidden = !part; c.disabled = !part; c.required = part;
}

// ---- Stappen ----
const secties = [...document.querySelectorAll(".stap")];
const balk = document.getElementById("stappen");
let stap = 1, verst = 1;
balk.innerHTML = STAPPEN.map((s, i) => `<li><button type="button" data-naar="${i + 1}"><span class="nr">${i + 1}</span><span class="lbl">${s}</span></button></li>`).join("");
secties.forEach((sec, i) => {
  const v = sec.querySelector(".verder");
  if (v) v.innerHTML = "Volgende: " + STAPPEN[i + 1].toLowerCase() + ' <span class="arr" aria-hidden="true">→</span>';
});
// Zichtbaar binnen de stap (verborgen blokken en uitgeschakelde velden tellen niet mee).
function telt(el, sec) {
  if (el.disabled) return false;
  for (let p = el.parentElement; p && p !== sec; p = p.parentElement) if (p.hidden) return false;
  return true;
}
function fouten(n) {
  const sec = secties[n - 1];
  return [...sec.querySelectorAll("[required]")].filter(el => telt(el, sec))
    .filter(el => el.type === "radio" ? !intakeForm.querySelector('input[name="' + el.name + '"]:checked')
      : el.type === "checkbox" ? !el.checked : !el.value.trim() || !el.checkValidity());
}
function labelVan(el) { if (el.dataset.label) return el.dataset.label; return (intakeForm.querySelector(`label[for="${el.id}"]`)?.innerText || el.name).replace(/\s*\*\s*$/, "").split("\n")[0].replace(/\s*\*.*$/, "").replace(/[.?]$/, ""); }
function meldFout(n, tekst) {
  const p = n === 5 ? document.getElementById("formerr") : secties[n - 1].querySelector("[data-err]");
  p.textContent = tekst; p.hidden = !tekst;
}
function geldig(n) {
  meldFout(n, "");
  if (n === 1 && termijn && (termijn.soort === "laat" || termijn.soort === "buiten")) {
    meldFout(1, termijn.soort === "buiten" ? termijn.reden : "Deze aanvraag kan niet meer op tijd ingediend worden bij " + termijn.gemeente + ". Kies een latere datum als dat kan.");
    document.getElementById("termijn").scrollIntoView({ block: "center", behavior: "smooth" });
    return false;
  }
  const bad = fouten(n);
  if (bad.length) { meldFout(n, "Nog niet alles is ingevuld: " + bad.map(labelVan).join(", ") + "."); (bad[0].hidden && bad[0].nextElementSibling ? bad[0].nextElementSibling : bad[0]).focus(); return false; }
  return true;
}
function gaNaar(n, push) {
  stap = n; verst = Math.max(verst, n);
  secties.forEach((s, i) => s.hidden = i + 1 !== n);
  [...balk.children].forEach((li, i) => {
    const b = li.firstElementChild;
    li.classList.toggle("klaar", i + 1 < n);
    if (i + 1 === n) li.setAttribute("aria-current", "step"); else li.removeAttribute("aria-current");
    b.disabled = i + 1 > verst;
  });
  if (n === 5) { toonOverzicht(); toonVolmacht(); toonPrijs(); toonHerroeping(); }
  if (push !== false) { try { history.pushState({ stap: n }, "", "#stap-" + n); } catch (e) {} }
  bewaar();
  const top = balk.getBoundingClientRect().top + window.scrollY - 16;
  if (window.scrollY > top) window.scrollTo({ top, behavior: "smooth" });
  secties[n - 1].querySelector(".stap-h").focus({ preventScroll: true });
}
secties.forEach((sec, i) => {
  const v = sec.querySelector(".verder"), t = sec.querySelector(".terug");
  if (v) v.addEventListener("click", async () => { if (i === 0) { await regelsKlaar; toonTermijn(); } if (geldig(i + 1)) gaNaar(i + 2); });
  if (t) t.addEventListener("click", () => gaNaar(i));
});
balk.addEventListener("click", e => {
  const b = e.target.closest("button[data-naar]"); if (!b || b.disabled) return;
  const doel = +b.dataset.naar;
  for (let n = stap; n < doel; n++) if (!geldig(n)) { if (n !== stap) gaNaar(n); return; }
  gaNaar(doel);
});
window.addEventListener("popstate", e => { const n = (e.state && e.state.stap) || 1; if (n <= verst) gaNaar(n, false); });

// Overzicht in stap 5, met een knop om terug te gaan naar de stap.
function toonOverzicht() {
  const opt = id => { const s = document.getElementById(id); return s.selectedIndex > 0 ? s.options[s.selectedIndex].text : ""; };
  const uren = [veld("startuur"), veld("einduur")].filter(Boolean).join(" tot ");
  const eind = veld("einddatum") && veld("einddatum") !== veld("startdatum") ? " tot " + datumNL(veld("einddatum")) : "";
  const matAantal = [...ml.querySelectorAll("input")].filter(i => +i.value > 0).length;
  const rijen = [
    ["Gemeente", veld("gemeente"), 1],
    ["Evenement", [veld("evenement_naam"), opt("type")].filter(Boolean).join(" · "), 2],
    ["Datum", veld("startdatum") ? datumNL(veld("startdatum")) + eind + (uren ? ", " + uren : "") : "", 2],
    ["Waar", [veld("locatie_naam"), veld("locatie"), opt("locatie_soort")].filter(Boolean).join(" · "), 2],
    ["Aanwezigen", veld("bezoekers") ? veld("bezoekers") + " tegelijk" : "", 1],
    ["Plan", { "bijgevoegd": "ik voeg het toe", "hulp nodig": "hulp via de plantekenaar", "later": "bezorg ik later" }[gekozen("inplantingsplan")] || "", 4],
    ["Bijlagen", alleBestanden().length ? alleBestanden().length + " bestand(en)" : "geen, bezorg ik later", 4],
    ["Documenten", DOCS.filter(d => d.toon()).map(d => d.naam.split(" ")[0] + ": " + ({ nu: "toegevoegd", later: "later", geen: "geen verzekering", nvt: "niet van toepassing" }[gekozen("doc_" + d.k)] || "–")).join(", "), 4],
    ["Materiaal", geenUitleen() ? "niet bij de gemeente" : gekozen("materiaal") === "ja" ? (matAantal ? matAantal + " soort(en) materiaal" : "ja") : gekozen("materiaal"), 4]
  ];
  const dl = document.getElementById("overzicht");
  dl.innerHTML = "";
  rijen.forEach(([k, v, s]) => {
    const dt = document.createElement("dt"), dd = document.createElement("dd"), b = document.createElement("button");
    dt.textContent = k; dd.textContent = v || "–";
    b.type = "button"; b.textContent = "wijzig"; b.setAttribute("aria-label", "Wijzig " + k.toLowerCase()); b.addEventListener("click", () => gaNaar(s));
    const w = document.createElement("dd"); w.appendChild(b);
    dl.append(dt, dd, w);
  });
}

// ---- Tussentijds bewaren in dit tabblad (sessionStorage), zodat terug of herladen niets wist. Geen bijlagen, geen akkoordvinkjes. ----
const NIET_BEWAREN = new Set(["website", "toestemming_privacy", "toestemming_mandaat", "herroeping"]);
let verzonden = false;
function bewaar() {
  if (verzonden) return;
  const v = {};
  [...intakeForm.elements].forEach(el => {
    if (!el.name || NIET_BEWAREN.has(el.name) || el.type === "file") return;
    if (el.type === "radio") { if (el.checked) v[el.name] = el.value; }
    else if (el.type === "checkbox") { if (el.checked) (v[el.name] = v[el.name] || []).push(el.value); }
    else v[el.name] = el.value;
  });
  const mat = {}; ml.querySelectorAll("input").forEach(i => { if (i.value) mat[i.id] = i.value; });
  try { sessionStorage.setItem(CONCEPT, JSON.stringify({ v, mat, stap, verst })); } catch (e) {}
}
function herstel() {
  let c = null; try { c = JSON.parse(sessionStorage.getItem(CONCEPT) || "null"); } catch (e) {}
  if (!c || !c.v) return null;
  Object.entries(c.v).forEach(([n, w]) => {
    intakeForm.querySelectorAll('[name="' + n + '"]').forEach(el => {
      if (el.type === "radio") el.checked = el.value === w;
      else if (el.type === "checkbox") el.checked = Array.isArray(w) && w.includes(el.value);
      else el.value = w;
    });
  });
  Object.entries(c.mat || {}).forEach(([id, w]) => { const i = document.getElementById(id); if (i) i.value = w; });
  return c;
}
let bewaarT = null;
intakeForm.addEventListener("input", () => { clearTimeout(bewaarT); bewaarT = setTimeout(bewaar, 300); });
intakeForm.addEventListener("change", () => { bewaar(); });
// Een foutmelding verdwijnt zodra je iets aanpast; bij "Volgende" wordt opnieuw gecontroleerd.
["input", "change"].forEach(t => intakeForm.addEventListener(t, () => { if (stap < 5) meldFout(stap, ""); }));
intakeForm.addEventListener("input", () => { if (stap === 5) { toonVolmacht(); toonPrijs(); toonHerroeping(); } });
intakeForm.addEventListener("change", () => { if (stap === 5) { toonVolmacht(); toonPrijs(); toonHerroeping(); } });

// Opstart: eerst het bewaarde concept, daarna (enkel lege velden) wat uit de termijncheck op de startpagina komt.
const concept = herstel();
(function () {
  const q = new URLSearchParams(location.search);
  let mee = {}; try { mee = JSON.parse(sessionStorage.getItem("termijncheck") || "{}") || {}; } catch (e) {}
  const gem = q.get("gemeente") || mee.gemeente, dat = q.get("datum") || mee.datum, typ = q.get("type") || mee.type, ts = document.getElementById("type");
  if (gem && !g.value && [...g.options].some(o => o.value === gem)) g.value = gem;
  if (typ && !ts.value && [...ts.options].some(o => o.value === typ)) ts.value = typ;
  if (dat && !sd.value && /^\d{4}-\d{2}-\d{2}$/.test(dat)) sd.value = dat;
})();
zoeker.sync(); volgEinddatum(); pasAan(); toonTermijn();
if (concept && concept.verst) verst = Math.min(5, concept.verst);
const startStap = Math.min(verst, +((location.hash.match(/^#stap-(\d)$/) || [])[1]) || (concept && concept.stap) || 1);
try { history.replaceState({ stap: startStap }, "", "#stap-" + startStap); } catch (e) {}
gaNaar(startStap, false);
if (startStap === 1) window.scrollTo(0, 0);

// ---- Doorsturen ----
form.addEventListener("submit", async e => {
  e.preventDefault();
  const err = document.getElementById("formerr"), st = document.getElementById("status"), btn = document.getElementById("send");
  err.hidden = true;
  await regelsKlaar; toonTermijn();
  // Alle stappen opnieuw nakijken; bij een fout naar die stap.
  for (let n = 1; n <= 5; n++) { if (!geldig(n)) { if (n !== 5) gaNaar(n); return; } }
  const data = Object.fromEntries(new FormData(form).entries());
  data.speciaal = new FormData(form).getAll("speciaal").join(", ");
  if (data.uit_publiceren !== "ja") { data.uit_tekst = ""; data.uit_prijs = ""; }
  data.toestemming_privacy = form.toestemming_privacy.checked ? "ja" : "nee";
  data.toestemming_mandaat = form.toestemming_mandaat.checked ? "ja" : "nee";
  data.termijn_oordeel = termijn ? termijn.soort : "onbekend";
  const isoD = d => d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
  data.termijn_deadline = termijn && termijn.deadline ? isoD(termijn.deadline) : "";
  data.termijn_regel = (termijn && termijn.termijn) || "";
  // Verborgen blokken sturen niets mee.
  if (document.getElementById("tentwrap").hidden) { data.tent_afmetingen = ""; data.tent_verhuurder = ""; }
  if (document.getElementById("zaalwrap").hidden) delete data.zaal_grondplan;
  if (document.getElementById("odwrap").hidden) data.od_zone = "";
  const mat = [...ml.querySelectorAll(".matrow")].filter(r => !r.hidden).map(r => r.querySelector("input")).filter(i => +i.value > 0).map(i => `${i.id.slice(4)}=${Math.floor(+i.value)}`);
  data.materiaal_lijst = data.materiaal === "ja" ? mat.join("; ") : "";
  if (data.materiaal !== "ja") { data.materiaal_andere = ""; data.materiaal_levering = ""; }
  const files = alleBestanden();
  if (files.reduce((s, x) => s + x.f.size, 0) > MAX_BYTES) {
    gaNaar(4); meldFout(4, "De bestanden zijn samen groter dan 10 MB. Kies kleinere bestanden of bezorg ze later."); return;
  }
  if (files.length > 10) {
    gaNaar(4); meldFout(4, "Je kan samen hoogstens 10 bestanden toevoegen. De rest mag je later bezorgen."); return;
  }
  if (files.some(x => !/^(application\/pdf|image\/jpeg|image\/png)$/.test(x.f.type))) {
    gaNaar(4); meldFout(4, "Alleen pdf, jpg of png kan als bijlage."); return;
  }
  DOCS.forEach(d => { if (!d.toon()) data["doc_" + d.k] = ""; });
  data.doc_extra = DOCS.filter(d => d.extra && d.toon()).map(d => d.k + "=" + (gekozen("doc_" + d.k) || "")).join("; ");
  DOCS.filter(d => d.extra).forEach(d => delete data["doc_" + d.k]);
  data.bijlagen = await Promise.all(files.map(async x => ({ naam: x.naam, type: x.f.type, data: await leesB64(x.f) })));
  btn.disabled = true; st.textContent = "";
  // Wachtscherm: het opslaan, de volmacht en de betaallink duren enkele seconden.
  const bezig = document.getElementById("bezig"), bs = document.getElementById("bezig-stap");
  const STATUS = ["Gegevens veilig opslaan…", "Je volmacht opmaken…", "Termijn vastleggen…", "Betaallink klaarzetten…", "Bijna klaar…"];
  let si = 0; bs.textContent = STATUS[0];
  const tik = setInterval(() => { si = Math.min(si + 1, STATUS.length - 1); bs.textContent = STATUS[si]; }, 2500);
  form.hidden = true; balk.hidden = true; document.getElementById("intro").hidden = true; bezig.hidden = false;
  window.scrollTo({ top: 0 });
  try {
    let j;
    if (!ENDPOINT) { j = { id: "DEMO-" + Date.now().toString(36).toUpperCase() }; }
    else {
      const r = await fetch(ENDPOINT, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify(data) });
      j = await r.json();
      if (!j.ok) throw new Error(j.error || "onbekende fout");
    }
    verzonden = true; clearTimeout(bewaarT);
    try { sessionStorage.removeItem(CONCEPT); } catch (e) {}
    document.getElementById("dossierid").textContent = j.id;
    // Enkel een https-link van Mollie tonen.
    const betaal = typeof j.betaalUrl === "string" && /^https:\/\/[\w.-]*mollie\.com\//.test(j.betaalUrl);
    document.getElementById("done-betaal").hidden = !betaal;
    document.getElementById("done-navraag").hidden = betaal;
    if (betaal) {
      document.getElementById("done-kop").textContent = "Je bent er bijna.";
      document.getElementById("betaalformule").textContent = j.formule || "";
      document.getElementById("betaallink").href = j.betaalUrl;
      document.getElementById("betaalbedrag").textContent = j.bedrag ? "€ " + j.bedrag : "";
      if (!j.bedrag) document.getElementById("betaalbedrag").parentElement.hidden = true;
    }
    clearInterval(tik); bezig.hidden = true;
    form.hidden = true; balk.hidden = true; document.getElementById("done").hidden = false;
    window.scrollTo({ top: 0 });
  } catch (x) {
    clearInterval(tik); bezig.hidden = true;
    form.hidden = false; balk.hidden = false; document.getElementById("intro").hidden = false;
    btn.disabled = false; st.textContent = "";
    err.textContent = "Doorsturen lukte niet (" + x.message + "). Probeer opnieuw, of mail ons je gegevens.";
    err.hidden = false; err.scrollIntoView({ block: "center" });
  }
});
</script>
