// Zelfde regel als nodigePlannen() in /plan/tekenaar.js.
function nodigePlannen() {
  const sit = { zaal: "zaal", tent: "tent", buiten: "buiten", combinatie: "tent" }[veld("locatie_soort")] || "";
  const gem = veld("gemeente"), pg = PLANNEN[gem] || {}, r = { inplanting: [], grondplan: [] };
  if (sit === "tent") { r.inplanting.push("tent"); r.grondplan.push("tent"); }
  if (sit === "buiten") r.inplanting.push("buiten");
  if (sit === "zaal") r.grondplan.push("zaal");
  if (/^(ja|deels)$/.test(veld("openbaar_domein"))) r.inplanting.push("openbaar domein");
  if ((+veld("bezoekers") || 0) >= 500) r.inplanting.push("500 aanwezigen of meer");
  if (pg.inplanting) r.inplanting.push(gem + " vraagt het");
  if (pg.grondplan && sit !== "buiten") r.grondplan.push(gem + " vraagt het");
  return r;
}
function geenUitleen() {
  const r = regelVan(), u = (r && r.uitleen) || {};
  if (u.uitleendienst === "nee") return "leent geen materiaal uit";
  if (veld("aanvrager_type") === "particulier" && u.particulieren_toegelaten === "nee") return "leent geen materiaal uit aan particulieren";
  return "";
}
function prijsVoor() {
  const bez = +veld("bezoekers") || 0, plan = gekozen("inplantingsplan");
  const formule = plan === "hulp nodig" || bez >= 500 ? "Plus" : "Basis";
  const factor = veld("aanvrager_type") === "bedrijf" ? 2 : 1;
  return { formule, bedrag: { Basis: 45, Plus: 75 }[formule] * factor, factor };
}

