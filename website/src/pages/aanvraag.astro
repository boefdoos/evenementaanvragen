    (!x.als || ((!x.als.types || x.als.types.includes(type)) && Object.keys(x.als).every(k => k === "types"))));
  if (d.extra) return gem + " vraagt dit bij een " + (veld("type") || "evenement") + ". Heb je het nog niet, dan mailen we je een leeg exemplaar.";
