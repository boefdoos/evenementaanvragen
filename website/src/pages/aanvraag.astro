// Volmachttekst: zelfde sjabloon als in Code.gs (volmachtTekst). Bij wijzigen: beide aanpassen en VOLMACHT_VERSIE ophogen.
const VOLMACHTHEBBER = "Troostberg (ondernemingsnummer 0791.797.538), handelend onder de naam evenementaanvragen.be (thomas@evenementaanvragen.be)";
function datumNL(iso) {
  if (!iso) return "[datum]";
  return new Date(iso + "T12:00:00").toLocaleDateString("nl-BE", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
}
function volmachtTekst(d) {
  const v = x => String(d[x] || "").trim();
  const org = v("aanvrager_type") === "particulier" || !v("organisatie") ? "in eigen naam" : v("organisatie") + (v("ondernemingsnummer") ? ", ondernemingsnummer " + v("ondernemingsnummer") : "");
  return `Ondergetekende, ${v("volmacht_naam") || "[naam]"}, ${v("volmacht_functie") || "[hoedanigheid]"}, handelend ${org === "in eigen naam" ? "in eigen naam" : "namens " + org}${v("adres_organisator") ? ", " + v("adres_organisator") : ""},

geeft volmacht aan ${VOLMACHTHEBBER}

om in naam en voor rekening van de organisator de evenementaanvraag en de bijhorende aanvragen (zoals uitleenmateriaal) voor het evenement "${v("evenement_naam") || "[evenement]"}" op ${datumNL(v("startdatum"))} in ${v("gemeente") || "[gemeente]"} voor te bereiden en in te dienen bij de gemeente, via de kanalen die de gemeente daarvoor gebruikt.

De organisator blijft verantwoordelijk voor de juistheid van de gegevens, voor de organisatie van het evenement en voor de naleving van de vergunningsvoorwaarden. Na de indiening communiceert de gemeente rechtstreeks met de organisator. Deze volmacht geldt enkel voor dit evenement. Ze loopt tot 30 dagen na de indiening, zodat we een vraag van de gemeente over het ingediende dossier kunnen beantwoorden, en kan altijd ingetrokken worden met een mail aan thomas@evenementaanvragen.be.`;
}
const vt = document.getElementById("volmachttekst");
function toonVolmacht() { vt.textContent = volmachtTekst(Object.fromEntries(new FormData(document.getElementById("intake")).entries())); }
document.getElementById("intake").addEventListener("input", toonVolmacht);
document.getElementById("intake").addEventListener("change", toonVolmacht);
toonVolmacht();

// Prijs: zelfde regels als prijsVoor() in Betaling.gs. Plus = hulp bij het plan (plantekenaar) of 500 bezoekers of meer.
function prijsVoor() {
  const bez = +veld("bezoekers") || 0;
  const plan = (intakeForm.querySelector('input[name="inplantingsplan"]:checked') || {}).value;
  const formule = plan === "hulp nodig" || bez >= 500 ? "Plus" : "Basis";
  return { formule, bedrag: { Basis: 45, Plus: 75 }[formule] * (veld("aanvrager_type") === "bedrijf" ? 2 : 1) };
}
function toonPrijs() {
  const box = document.getElementById("prijs");
  if (!veld("aanvrager_type") || !veld("bezoekers") || !veld("locatie_soort")) { box.hidden = true; return; }
  const p = prijsVoor();
  box.innerHTML = '<span>' + p.formule + (veld("aanvrager_type") === "bedrijf" ? ", tarief bedrijf of zelfstandige" : "") + '</span><b>€ ' + p.bedrag + '</b>';
  box.hidden = false;
}
function toonHerroeping() {
  const part = veld("aanvrager_type") === "particulier", w = document.getElementById("herroepwrap"), c = document.getElementById("herroeping");
  w.hidden = !part; c.disabled = !part; c.required = part;
}
intakeForm.addEventListener("input", () => { toonPrijs(); toonHerroeping(); });
intakeForm.addEventListener("change", () => { toonPrijs(); toonHerroeping(); });
toonPrijs(); toonHerroeping();

const form = document.getElementById("intake");
form.addEventListener("submit", async e => {
  e.preventDefault();
  const err = document.getElementById("formerr"), st = document.getElementById("status"), btn = document.getElementById("send");
  err.hidden = true;
  await regelsKlaar; toonTermijn();
  if (termijn && termijn.soort === "buiten") {
    err.textContent = termijn.reden; err.hidden = false;
    document.getElementById("termijn").scrollIntoView({ block: "center", behavior: "smooth" }); return;
  }
  if (termijn && termijn.soort === "laat") {
    err.textContent = "Deze aanvraag kan niet meer op tijd ingediend worden bij " + termijn.gemeente + ". Kies een latere datum als dat kan.";
    err.hidden = false; document.getElementById("termijn").scrollIntoView({ block: "center", behavior: "smooth" }); return;
  }
  const bad = [...form.querySelectorAll("[required]")].filter(el => el.type === "checkbox" ? !el.checked : !el.value.trim() || !el.checkValidity());
  if (bad.length) {
    err.textContent = "Nog niet alles is ingevuld: " + bad.map(el => (form.querySelector(`label[for="${el.id}"]`)?.innerText || el.name).replace(/\s*\*\s*$/,"").split("\n")[0]).join(", ") + ".";
    err.hidden = false; bad[0].focus(); return;
  }
  const data = Object.fromEntries(new FormData(form).entries());
  data.toestemming_privacy = form.toestemming_privacy.checked ? "ja" : "nee";
  data.toestemming_mandaat = form.toestemming_mandaat.checked ? "ja" : "nee";
  data.termijn_oordeel = termijn ? termijn.soort : "onbekend";
  const isoD = d => d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
  data.termijn_deadline = termijn && termijn.deadline ? isoD(termijn.deadline) : "";
  data.termijn_regel = (termijn && termijn.termijn) || "";
  const mat = [...ml.querySelectorAll("input")].filter(i => +i.value > 0).map(i => `${i.id.slice(4)}=${Math.floor(+i.value)}`);
  data.materiaal_lijst = data.materiaal === "ja" ? mat.join("; ") : "";
  if (data.materiaal !== "ja") { data.materiaal_andere = ""; data.materiaal_levering = ""; }
  const files = [...fi.files];
  if (files.reduce((s, f) => s + f.size, 0) > MAX_BYTES) {
    err.textContent = "De bijlagen zijn samen groter dan 10 MB. Kies kleinere bestanden of bezorg ze later.";
    err.hidden = false; fi.focus(); return;
  }
  if (files.some(f => !/^(application\/pdf|image\/jpeg|image\/png)$/.test(f.type))) {
    err.textContent = "Alleen pdf, jpg of png kan als bijlage.";
    err.hidden = false; fi.focus(); return;
  }
  data.bijlagen = await Promise.all(files.map(async f => ({ naam: f.name, type: f.type, data: await leesB64(f) })));
  btn.disabled = true; st.textContent = "Bezig met doorsturen…";
  try {
    let j;
    if (!ENDPOINT) { j = { id: "DEMO-" + Date.now().toString(36).toUpperCase() }; }
    else {
      const r = await fetch(ENDPOINT, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify(data) });
      j = await r.json();
      if (!j.ok) throw new Error(j.error || "onbekende fout");
    }
    document.getElementById("dossierid").textContent = j.id;
    // Enkel een https-link van Mollie tonen.
    const betaal = typeof j.betaalUrl === "string" && /^https:\/\/[\w.-]*mollie\.com\//.test(j.betaalUrl);
    document.getElementById("done-betaal").hidden = !betaal;
    document.getElementById("done-navraag").hidden = betaal;
    if (betaal) {
      document.getElementById("done-kop").textContent = "Je bent er bijna.";
      document.getElementById("betaalformule").textContent = j.formule || "";
      document.getElementById("betaallink").href = j.betaalUrl;
      document.getElementById("betaalbedrag").textContent = j.bedrag ? "€ " + j.bedrag : "";
      if (!j.bedrag) document.getElementById("betaalbedrag").parentElement.hidden = true;
    }
    form.hidden = true; document.getElementById("done").hidden = false;
    document.getElementById("done").scrollIntoView({ block: "start" });
  } catch (x) {
    btn.disabled = false; st.textContent = "";
    err.textContent = "Doorsturen lukte niet (" + x.message + "). Probeer opnieuw, of mail ons je gegevens.";
    err.hidden = false;
  }
});
</script>
