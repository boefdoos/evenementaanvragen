// Leesbare zin over de plannen, bv. "Brugge vraagt een inplantingsplan. Voor de zaal heb je daarnaast een grondplan nodig."
function planZin() {
  const p = nodigePlannen(), gem = esc(veld("gemeente")), vraagt = x => /vraagt het$/.test(x);
  const zinnen = [];
  if (p.inplanting.length) {
    const rest = p.inplanting.filter(x => !vraagt(x)).map(x => ({ tent: "er een tent staat", buiten: "het buiten plaatsvindt", "openbaar domein": "er iets op straat, stoep of plein komt", "500 aanwezigen of meer": "er 500 of meer mensen tegelijk zijn" })[x] || x);
    if (!rest.length) zinnen.push(gem + " vraagt een <b>inplantingsplan</b>.");
    else zinnen.push("Je hebt een <b>inplantingsplan</b> nodig, omdat " + rest.join(" en ") + "." + (p.inplanting.some(vraagt) ? " " + gem + " vraagt het ook." : ""));
  }
  if (p.grondplan.length) {
    const van = p.grondplan.includes("tent") ? " van de tent" : p.grondplan.includes("zaal") ? " van de zaal" : "";
    const alleenGemeente = p.grondplan.every(vraagt);
    zinnen.push(alleenGemeente ? gem + " vraagt ook een <b>grondplan</b>." : (zinnen.length ? "Daarnaast heb je een <b>grondplan</b>" + van + " nodig" : "Je hebt een <b>grondplan</b>" + van + " nodig") + "; de brandweer vraagt dat meestal.");
  }
  return zinnen.join(" ");
}
function esc(s) { return String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]); }

