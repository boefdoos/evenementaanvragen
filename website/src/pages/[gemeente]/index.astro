---
// Eén pagina per gemeente met eigen gegevens (status ok of onzeker), uit public/regels.json.
// Gemeenten met status 'onbekend' krijgen geen pagina: zonder eigen gegevens zou het een lege kopie zijn.
import Basis from "../../layouts/Basis.astro";
import huisstijl from "../../huisstijl.css?raw";
import extraCss from "../../gemeentepagina.css?raw";
import regels from "../../../public/regels.json";
import { slug } from "../../slug.js";

export function getStaticPaths() {
  return regels
    .map((r) => ({ params: { gemeente: slug(r.gemeente) }, props: { r } }));
}


const DOMEIN = "https://evenementaanvragen.be";
const TYPES = { "*": "Evenementen in het algemeen", concert: "Concert of festival", fuif: "Fuif of bal",
  buurtfeest: "Buurt- of straatfeest", eetfestijn: "Eetfestijn", markt: "Markt of rommelmarkt",
  braderij: "Braderij", kermis: "Kermis", stoet: "Stoet of optocht", sport: "Sportactiviteit",
  wielerwedstrijd: "Wielerwedstrijd", schoolfeest: "Schoolfeest", tentoonstelling: "Tentoonstelling", andere: "Andere" };
const BUITEN_AANBOD = new Set(["stoet", "wielerwedstrijd"]);
const UNIT = { d: ["dag", "dagen"], w: ["week", "weken"], m: ["maand", "maanden"], wd: ["werkdag", "werkdagen"] };
const MAT = { nadars: "nadarafsluitingen", heras: "werfhekken", tafels: "tafels", stoelen: "stoelen",
  banken: "bierbanken", podium: "podiumelementen", tent: "tenten", borden: "signalisatieborden",
  vuilbakken: "vuilbakken", stroom: "stroomkasten", water: "wateraansluiting", toiletten: "toiletten" };
const termijn = (n, u) => `${n} ${UNIT[u][n === 1 ? 0 : 1]}`;
// Woorden die op onderzoeksnotities wijzen: niet publiceren.
const INTERN = /niet expliciet|niet (gelezen|vermeld|gevonden|leesbaar)|onbekend|geblokkeerd|robots|client_error|limiet|aanname|strengste|gemapt|nakijken|navragen|geen (e-mail|telefoon)[^;,)]*vermeld|softwarenaam|geen [^;.]*vermeld|eigen loket \/ anders/i;
// Haalt onderzoeksnotities uit een veld: zinnen, ;-delen, (haakjes) en " – "-delen die erop wijzen vallen weg.
const schoon = (t) => {
  if (!t) return "";
  return String(t)
    .split(/;\s*|(?<=\.)\s+/)
    .map((d) => d.replace(/\s*\([^)]*\)/g, (m) => (INTERN.test(m) ? "" : m)).split(" – ").filter((x) => !INTERN.test(x)).join(" – "))
    .map((d) => d.trim().replace(/[.;\s]+$/, ""))
    .filter((d) => d && !INTERN.test(d))
    .join("; ");
};
const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
// Haalt mailadressen en webadressen uit een tekst (met het "naar …"/"via …" ervoor en haakjes errond).
const ADRES = String.raw`[\w.+-]+@[\w.-]+\.\w+|https?:\/\/\S+|www\.\S+|\b[\w-]+(\.[\w-]+)*\.(be|com|eu|org)\b(\/\S*)?`;
const zonderAdres = (t) => String(t || "")
  .replace(new RegExp(String.raw`\s*\([^)]*(${ADRES})[^)]*\)`, "gi"), "")
  .replace(new RegExp(String.raw`\s*(,\s*)?\b(naar|aan|via|bij|op)\s+(${ADRES})(\s*(en|,)\s*(${ADRES}))*`, "gi"), "")
  .replace(new RegExp(ADRES, "gi"), "")
  .replace(/\s{2,}/g, " ").replace(/\s+([,.;])/g, "$1").trim();

const { r } = Astro.props;
const g = r.gemeente;
const s = slug(g);
const provincie = r.provincie || "West-Vlaanderen";
const base = r.base || {};
const alg = base["*"];
const algTxt = alg ? termijn(alg[0], alg[1]) : null;
// Gemeente zonder gepubliceerde termijn: we rekenen met de strengste algemene termijn in de provincie.
const dagen = ([n, u]) => n * ({ d: 1, w: 7, m: 30.4, wd: 1.4 }[u] || 1);
const onbekend = !alg;
const streng = onbekend ? regels.filter((x) => (x.provincie || "West-Vlaanderen") === (r.provincie || "West-Vlaanderen") && x.status === "ok" && x.base && x.base["*"])
  .map((x) => x.base["*"]).sort((a, b) => dagen(b) - dagen(a))[0] : null;
const strengTxt = streng ? termijn(streng[0], streng[1]) : null;
// Platformnaam zonder url of uitleg tussen haakjes; enkel echte productnamen tonen we in de lead.
const PRODUCT = { eaglebe: "Eaglebe", flowlab: "Flowlab", riho: "RIHO", egovflow: "eGovflow", smartloket: "Smartloket", "power apps": "het e-loket van de stad", "geo-it evenementenloket": "Geo-IT", zoem: "ZOEM", spotbooking: "Spotbooking" };
const pkaal = String(r.platform || "").replace(/\s*\(.*$/, "").trim();
const platform = PRODUCT[pkaal.toLowerCase()] || null;
// Hoe er ingediend wordt, als vaststelling (geen handleiding en geen link naar het loket: dat doen wij).
const kanaal = platform
  ? `Online dossier via ${platform}, met bijlagen zoals plannen en affiche.`
  : /mail/i.test(pkaal) ? "Aanvraagformulier met bijlagen, in te dienen per mail."
  : pkaal && !INTERN.test(pkaal) ? "Online dossier via het e-loket van de gemeente, met bijlagen." : null;
const college = zonderAdres(schoon(r.college));
// Voorwaarden van de gemeente: tonen wat erbij komt kijken, zonder stappenplan.
const voorwaarden = (r.bijzonder || [])
  .filter((b) => b.soort === "voorwaarde" && b.wat && !INTERN.test(b.wat))
  .map((b) => zonderAdres(b.wat).replace(/[.;:,\s]+$/, ""))
  .filter((v) => v.length > 8)
  .map((v) => cap(v) + ".")
  .slice(0, 6);
const u = r.uitleen || {};
const bronnen = Array.isArray(r.bron) ? r.bron : [r.bron];
const bron = bronnen.find((b) => /^https?:\/\//.test(String(b || "")));
const perMail = bronnen.some((b) => /^Mail /.test(String(b || "")));
const start = `/aanvraag?gemeente=${encodeURIComponent(g)}`;
// Andere gemeenten uit dezelfde provincie (alfabetisch rond deze gemeente), voor interne links.
const zelfde = regels.filter((x) => (x.provincie || "West-Vlaanderen") === provincie)
  .map((x) => x.gemeente).sort((a, b) => a.localeCompare(b, "nl"));
const pos = zelfde.indexOf(g);
const vanaf = Math.max(0, Math.min(pos - 4, zelfde.length - 9));
const andere = zelfde.slice(vanaf, vanaf + 9).filter((x) => x !== g).slice(0, 8);

const title = `Evenement aanvragen in ${g}: termijn en werkwijze`;
const desc = algTxt
  ? `Een evenement in ${g}? Vraag het minstens ${algTxt} op voorhand aan${platform ? ` via ${platform}` : ""}. Bereken je deadline en laat ons het dossier opmaken en indienen.`
  : `Een evenement in ${g}? ${g} publiceert geen vaste termijn: wij rekenen met de strengste termijn in de provincie en vragen het na. Laat ons het dossier opmaken en indienen.`;

// Termijnen
const rijen = [];
for (const [k, [n, unit]] of Object.entries(base).sort((a, b) => (a[0] !== "*") - (b[0] !== "*") || a[0].localeCompare(b[0]))) {
  rijen.push({ wat: TYPES[k] || k, tag: BUITEN_AANBOD.has(k), termijn: termijn(n, unit) });
}
for (const x of r.extra || []) {
  const v = [];
  if (x.minVisitors) v.push(`vanaf ${x.minVisitors} bezoekers`);
  if (x.groot) v.push("groot evenement");
  if (x.nieuw) v.push("eerste editie");
  if (x.openbaarDomein) v.push("op openbaar domein");
  if (x.types) v.push(x.types.map((t) => (TYPES[t] || t).toLowerCase()).join(", "));
  rijen.push({ wat: cap(v.join(", ")) || "Bijzonder geval", tag: false, termijn: termijn(x.n, x.unit) });
}
for (const b of r.bijzonder || []) {
  if ((b.soort === "deadline" || b.soort === "vroegst") && b.n && !INTERN.test(b.wat)) rijen.push({ wat: zonderAdres(b.wat), tag: false, termijn: termijn(b.n, b.unit) });
}

// Feestmateriaal (enkel het publieke deel; onderzoeksnotities horen niet op de site)
let mat = null;
if (u.uitleendienst === "ja") {
  const items = Object.entries(u.catalogus || {}).filter(([k, v]) => v === "ja" && MAT[k]).map(([k]) => MAT[k]);
  const part = { ja: "Ook particulieren mogen lenen.", nee: "Particulieren kunnen er niet lenen." }[u.particulieren_toegelaten] || "";
  const kosten = zonderAdres((u.kosten || "").split(";")[0]);
  mat = {
    items: items.length ? `Onder meer ${items.join(", ")}.` : null,
    termijn: u.termijn && !INTERN.test(u.termijn) ? `Aanvragen: ${zonderAdres(u.termijn).replace(/[.\s]+$/, "")}.` : null,
    part: part || null,
    kosten: kosten && !INTERN.test(kosten) ? `${kosten.replace(/[.\s]+$/, "")}.` : null,
  };
}

const ld = [
  { "@context": "https://schema.org", "@type": "Service", name: `Evenementaanvraag in ${g}`,
    serviceType: "Opmaken en indienen van evenementaanvragen", areaServed: { "@type": "City", name: g },
    provider: { "@type": "Organization", name: "evenementaanvragen.be", url: DOMEIN + "/" },
    url: `${DOMEIN}/${s}/`, offers: { "@type": "Offer", price: "45", priceCurrency: "EUR" } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "evenementaanvragen.be", item: DOMEIN + "/" },
    { "@type": "ListItem", position: 2, name: provincie },
    { "@type": "ListItem", position: 3, name: g, item: `${DOMEIN}/${s}/` }] },
];
---
<Basis title={title} description={desc} canonical={`/${s}/`} startHref={start}>
<Fragment slot="head">
<style is:inline set:html={huisstijl}></style>
<style is:inline set:html={extraCss}></style>
<script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
</Fragment>

<main>
<div class="wrap"><p class="crumbs"><a href="/">Start</a> · {provincie} · {g}</p></div>

<section class="hero" style="padding-top:28px"><div class="wrap">
  <div>
    <h1>Evenement aanvragen in <span>{g}</span></h1>
    {algTxt
      ? <p class="lead">In {g} vraag je een evenement minstens <b>{algTxt}</b> op voorhand aan{platform && <> via {platform}</>}.</p>
      : <p class="lead">{g} publiceert geen vaste termijn. Wij rekenen veiligheidshalve met {strengTxt ? <b>{strengTxt}</b> : "de strengste termijn"} op voorhand en vragen het na bij de gemeente.</p>}
    <div class="cta">
      <a class="btn primary" href={start}>Wij regelen het voor je <span class="arr" aria-hidden="true">→</span></a>
      <a class="btn" href="/#prijzen">Vanaf € 45</a>
    </div>
  </div>

  <aside class="panel" aria-labelledby="calc-t">
    <div class="k" id="calc-t">Hoeveel tijd heb je nog in {g}?</div>
    <div id="c-out" aria-live="polite">
      <div class="count"><span class="num">–</span><span class="unit">dagen</span></div>
      <div class="deadline">Kies soort en datum</div>
    </div>
    <form class="fields" onsubmit="return false" aria-label="Termijncheck">
      <label for="c-type">Soort<select id="c-type"></select></label>
      <label for="c-datum">Datum<input id="c-datum" type="date"></label>
    </form>
  </aside>
</div></section>

<section class="blk" style="padding-top:56px"><div class="wrap">
  <h2>Hoe lang op voorhand?</h2>
  <dl class="feiten">
    {onbekend && <div class="feit"><dt>Evenementen in het algemeen<small style="display:block;color:var(--dim);font-size:13px">geen termijn gepubliceerd; strengste in {provincie}</small></dt><dd>{strengTxt ? strengTxt + " vooraf" : "navragen"}</dd></div>}
    {rijen.map((x) => <div class="feit"><dt>{x.wat}{x.tag && <span class="tag">niet in ons aanbod</span>}</dt><dd>{x.termijn} vooraf</dd></div>)}
  </dl>
</div></section>

<section class="blk" style="padding-top:72px"><div class="wrap">
  <h2>Een aanvraag in {g}</h2>
  <div class="twee">
    <div class="vak"><h3>Wat erbij komt kijken</h3><ul>
      {kanaal && <li>{kanaal}</li>}
      {college && <li>{college}.</li>}
      {voorwaarden.map((v) => <li>{v}</li>)}
    </ul></div>
    {mat
      ? <div class="vak"><h3>Feestmateriaal lenen</h3><p>Materiaal van de uitleendienst vraag je in {g} apart aan. Wij nemen het mee in je dossier, met wat marge.</p>
          {(mat.items || mat.termijn || mat.part || mat.kosten) && <ul>{mat.items && <li>{mat.items}</li>}{mat.termijn && <li>{mat.termijn}</li>}{mat.part && <li>{mat.part}</li>}{mat.kosten && <li>{mat.kosten}</li>}</ul>}</div>
      : <div class="vak"><h3>Wat wij doen</h3><p>Wij berekenen je deadline, maken het volledige dossier op met formulieren, bijlagen en bewonersbrief, en dienen het in. Jij blijft het aanspreekpunt van de gemeente.</p></div>}
  </div>
  {bron && <p class="bron">Bron: <a href={bron} rel="nofollow noopener">website van {g}</a>. Nagekeken door evenementaanvragen.be{perMail && <>, en per mail bevestigd door de gemeente</>}.{r.status === "onzeker" && <> {g} publiceert geen eenduidige termijn: we rekenen met de strengste lezing.</>}{onbekend && <> {g} publiceert geen vaste termijn: we rekenen met de strengste termijn in de provincie en vragen het na.</>} De gemeente beslist altijd zelf; bij twijfel geldt wat zij publiceert.</p>}

  {andere.length > 0 && <nav class="andere" aria-label={`Andere gemeenten in ${provincie}`}>
    <div class="k">Andere gemeenten in {provincie}</div>
    <ul>{andere.map((x) => <li><a href={`/${slug(x)}/`}>{x}</a></li>)}<li><a href="/gemeenten/">Alle gemeenten →</a></li></ul>
  </nav>}

  <div class="final">
    <div><h2>Geen zin om alles uit te zoeken?</h2><p>Laat het aan ons over. Jij vult 10 minuten in, wij maken het dossier op en dienen het in bij de gemeente {g}.</p></div>
    <a class="btn primary" href={start}>Start je aanvraag <span class="arr" aria-hidden="true">→</span></a>
  </div>
</div></section>
</main>

<Fragment slot="scripts">
<script is:inline>var RULES = [];</script>
<script is:inline src="/rekenlogica.js"></script>
<script is:inline src="/indienmoment.js"></script>
<script is:inline define:vars={{ GEM: g }}>
(function(){
  const typ=$("c-type"), dat=$("c-datum"), out=$("c-out");
  TYPES.forEach(([k,v])=>typ.appendChild(new Option(v+(BUITEN_AANBOD_TYPES.includes(k)?" (nog niet in ons aanbod)":""),k)));
  typ.value="fuif";
  const t0=new Date(); t0.setDate(t0.getDate()+120); dat.value=t0.toISOString().slice(0,10);
  const iso=d=>d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");

  // Wat de bezoeker zelf koos, gaat mee naar het intakeformulier (via alle aanvraaglinks en voor deze sessie).
  let aangeraakt=false;
  function meeNemen(gemNaam){
    if(!aangeraakt) return;
    const v={gemeente:gemNaam,type:typ.value,datum:dat.value};
    try{sessionStorage.setItem("termijncheck",JSON.stringify(v));}catch(e){}
    document.querySelectorAll('a[href^="/aanvraag"]').forEach(a=>{
      const u=new URL(a.getAttribute("href"),location.origin);
      for(const [k,w] of Object.entries(v)) if(w) u.searchParams.set(k,w);
      a.setAttribute("href",u.pathname+u.search);
    });
  }
  function show(){
    meeNemen(GEM);
    const r=RULES.find(x=>x.gemeente===GEM); if(!r||!dat.value) return;
    const buiten=buitenAanbod(typ.value,0);
    if(buiten){out.innerHTML='<div class="count"><span class="num">–</span><span class="unit">dagen</span></div><div class="deadline">Niet in ons aanbod</div><p class="rule">'+esc(buiten)+'</p>';return;}
    const ev={gem:r.gemeente,type:typ.value,date:new Date(dat.value+"T00:00:00"),visitors:150,marge:5,groot:false,nieuw:false,od:false,x:{}};
    let res=evaluate(r,ev); if(res.unknown){const f=fallback(r,ev); if(f) res=f;}
    if(res.unknown){out.innerHTML='<div class="count"><span class="num">?</span><span class="unit">dagen</span></div><div class="deadline">Termijn nog niet gekend</div><p class="rule">Start je aanvraag, dan zoeken wij het voor je op.</p>';return;}
    const o=indienOordeel(res), st={laat:"late",twijfel:"tight",krap:"tight",ok:"ok",geschat:"ok"}[o.soort];
    const d=daysUntil(res.best.date), voorbij=res.best.date<today();
    const txt={laat:"te laat",twijfel:"onzeker",krap:"krap",ok:"op tijd",geschat:"schatting"}[o.soort];
    out.innerHTML='<div class="count"><span class="num">'+(voorbij?"0":String(d))+'</span><span class="unit">'+(d===1?"dag":"dagen")+'<br>tot je deadline</span></div>'+
      '<div class="deadline">Uiterlijk '+esc(fmtLong(res.best.date))+'<span class="status'+(st==="late"?" late":"")+'">'+txt+'</span></div>'+
      '<p class="rule">'+(st==="late"?"Deadline voorbij.":esc(label(res.best.n,res.best.u))+" vooraf")+'</p>'+
      (st==="late"?'':'<a class="go-link" href="/aanvraag?gemeente='+encodeURIComponent(GEM)+'&type='+encodeURIComponent(typ.value)+'&datum='+iso(ev.date)+'">Wij dienen het in voor je →</a>');
  }
  fetch("/regels.json").then(r=>r.json()).then(data=>{RULES=data;show();})
    .catch(()=>{out.innerHTML='<div class="deadline">De termijnen konden niet laden.</div><p class="rule">Start gerust je aanvraag: wij rekenen het voor je uit.</p>';});
  [typ,dat].forEach(el=>{const z=()=>{aangeraakt=true;show();};el.addEventListener("change",z);el.addEventListener("input",z)});
})();
</script>
</Fragment>
</Basis>
