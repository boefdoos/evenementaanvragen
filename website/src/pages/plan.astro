---
// Begeleide plantekenaar (inbegrepen in elke formule). Met dossiernummer en e-mail: gegevens uit de intake en opslaan in het dossier.
// Zonder login: demo, opslaan staat uit. Leaflet, jsPDF en lettertypes komen van de eigen server. De logica staat in /plan/tekenaar.js, de normen in /plan/normen.json.
import "@fontsource/unbounded/600.css";
import "@fontsource/unbounded/800.css";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import "@fontsource/instrument-sans/700.css";
---
<!doctype html>
<html lang="nl-BE">
<head>
<meta charset="utf-8">
<title>Plantekenaar · evenementaanvragen.be</title>
<meta name="description" content="Teken je inplantingsplan en grondplan stap voor stap, met controle op de eisen van de brandweer.">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css">
<style is:inline>
:root{
  --bg:#1a1d2b; --card:#232738; --card-2:#2a2f43; --line:rgba(255,255,255,.10); --line-2:rgba(255,255,255,.18);
  --text:#f5f4f2; --soft:#aab0c4; --dim:#7d839a; --accent:#ff5a4e; --sun:#ffc84a; --ok:#5fd39a;
  --grad:linear-gradient(95deg,var(--sun),var(--accent));
  --f-display:"Unbounded","Arial Black",Arial,sans-serif; --f-body:"Instrument Sans","Segoe UI",Arial,sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 var(--f-body);display:flex;flex-direction:column}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--text);outline-offset:2px}
.top{display:flex;align-items:center;gap:16px;padding:12px max(16px,env(safe-area-inset-left,0px));border-bottom:1px solid var(--line);flex-wrap:wrap}
.mark{display:inline-flex;align-items:baseline;gap:12px;color:var(--soft);text-decoration:none;font:600 13px/1 var(--f-display);letter-spacing:.02em}
.mark-logo{display:block;height:28px;width:auto}
@media (max-width:520px){.mark-dom{display:none}}
.mark-dom b{font-weight:inherit;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.dossier{margin-left:auto;font-size:13px;color:var(--soft);display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pill{border:1px solid var(--line-2);border-radius:999px;padding:3px 10px;font-weight:600;color:var(--text)}
.pill.demo{border-color:var(--sun);color:var(--sun)}
.tabs{display:flex;gap:6px}
.tabs button{border:1px solid var(--line-2);background:transparent;border-radius:999px;padding:7px 14px;font-weight:600;font-size:14px;color:var(--soft);cursor:pointer}
.tabs button[aria-selected="true"]{background:var(--text);color:var(--bg);border-color:var(--text)}
.app{flex:1;display:grid;grid-template-columns:340px minmax(0,1fr);min-height:0}
@media (max-width:820px){.app{grid-template-columns:1fr;grid-template-rows:auto 70vh}}
.side{border-right:1px solid var(--line);overflow:auto;padding:20px 18px 24px;display:flex;flex-direction:column;gap:18px;min-width:0}
@media (max-width:820px){.side{border-right:0;border-bottom:1px solid var(--line)}}
.steps{display:flex;gap:4px}
.steps button{flex:1;height:6px;border-radius:3px;border:0;background:var(--line-2);cursor:pointer;padding:0}
.steps button.klaar{background:var(--soft)}
.steps button.nu{background:var(--grad)}
.stapnr{font-size:13px;color:var(--soft);font-weight:600}
h1{font:600 22px/1.15 var(--f-display);letter-spacing:-.02em;margin:4px 0 0}
.uitleg{color:var(--soft);margin:0}
label{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:600;color:var(--soft);min-width:0}
input,select{background:var(--bg);border:1px solid var(--line-2);border-radius:10px;padding:0 12px;height:42px;width:100%;min-width:0;font-weight:500;font-size:15px}
.r2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.r3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--line-2);background:transparent;border-radius:999px;padding:10px 16px;font-weight:600;cursor:pointer;color:var(--text)}
.btn:hover{border-color:var(--soft)}
.btn.primary{background:var(--grad) border-box;color:var(--bg);border-color:transparent}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.nav{display:flex;gap:10px;margin-top:auto;padding-top:8px}
.nav .btn{flex:1}
.lijst{display:flex;flex-direction:column;gap:6px}
.item{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--line);border-radius:10px;cursor:pointer;font-size:14px;background:var(--card)}
.item.sel{border-color:var(--accent)}
.item .maat{margin-left:auto;color:var(--soft);font-size:13px}
.sw{width:12px;height:12px;border-radius:3px;flex:none}
.edit{border:1px solid var(--line-2);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:10px;background:var(--card)}
.nodig{margin:0;font-size:13px;color:var(--soft);border:1px solid var(--line);border-radius:10px;padding:8px 10px}
.nodig b{color:var(--text);font-weight:600}
.nodig small{display:block;margin-top:4px;color:var(--dim);font-size:12px}
.checks{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
.checks li{display:grid;grid-template-columns:20px minmax(0,1fr);gap:8px;font-size:14px}
.checks .i{font-weight:700}
.checks .ok .i{color:var(--ok)} .checks .no .i{color:var(--accent)} .checks .ad .i{color:var(--sun)}
.checks small{display:block;color:var(--dim);font-size:12px}
.melding{font-size:13px;color:var(--soft)}
.check{display:grid;grid-template-columns:auto 1fr;gap:8px;align-items:start;font-size:13.5px;line-height:1.45;cursor:pointer}
.check input{width:18px;height:18px;margin-top:2px;accent-color:var(--accent)}
label small{display:block;color:var(--soft);font-size:12px;margin-top:2px}
.stage{position:relative;min-width:0;min-height:0;background:#0f111a}
#map,#gp{position:absolute;inset:0}
#gp{overflow:auto;display:flex;align-items:flex-start;justify-content:center;padding:84px 24px 24px}
#gp svg{background:#fff;border-radius:4px;touch-action:none;max-width:none;user-select:none;-webkit-user-select:none}
/* Werkbalk vlak bij het plan */
.tools{position:absolute;top:12px;left:12px;right:12px;z-index:1000;display:flex;gap:6px;flex-wrap:wrap;align-items:center;pointer-events:none}
.tools > *{pointer-events:auto}
.tools button{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line-2);background:rgba(35,39,56,.94);backdrop-filter:blur(6px);color:var(--text);border-radius:999px;padding:8px 13px;font-weight:600;font-size:14px;cursor:pointer;box-shadow:0 2px 10px rgba(0,0,0,.3)}
.tools button:hover{border-color:var(--soft)}
.tools button.aan{background:var(--text);color:var(--bg)}
.tools .plus{font-weight:700;color:var(--accent)}
.banner{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);z-index:1000;background:rgba(35,39,56,.95);border:1px solid var(--line-2);padding:8px 14px;border-radius:12px;font-size:13px;max-width:90%}
.lbl{background:transparent;border:0}
.lbl span{display:inline-block;transform:translate(-50%,-50%);white-space:nowrap;font:600 11px var(--f-body);color:#111;background:rgba(255,255,255,.9);padding:1px 5px;border-radius:4px;border:1px solid rgba(0,0,0,.2);cursor:move}
.sym span{display:flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;font:700 11px var(--f-body);color:#fff;transform:translate(-50%,-50%);border:2px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.4);cursor:move}
.greep span{display:block;width:16px;height:16px;transform:translate(-50%,-50%);background:#fff;border:2px solid #1a1d2b;box-shadow:0 1px 4px rgba(0,0,0,.4)}
.greep.maat span{border-radius:3px;cursor:nwse-resize}
.greep.draai span{border-radius:50%;cursor:grab}
.voorbeeld{width:100%;border-radius:8px;border:1px solid var(--line-2);background:#fff;cursor:zoom-in}
/* Login */
.login{max-width:440px;margin:8vh auto;padding:28px;border:1px solid var(--line);border-radius:20px;background:var(--card);display:flex;flex-direction:column;gap:14px}
.login h1{font-size:26px}
.err{color:var(--accent);font-weight:600;font-size:14px}
.groot{position:fixed;inset:0;z-index:3000;background:rgba(10,12,20,.92);display:flex;align-items:center;justify-content:center;padding:20px;cursor:zoom-out}
.groot img{max-width:100%;max-height:100%;background:#fff;border-radius:6px}
</style>
</head>
<body>
<header class="top">
  <a class="mark" href="/" aria-label="EvA, evenementaanvragen.be, naar de startpagina"><img class="mark-logo" src="/eva.svg" alt="" width="63" height="28"><span class="mark-dom">evenementaanvragen<b>.be</b></span></a>
  <div class="tabs" id="tabs" role="tablist" hidden></div>
  <div class="dossier" id="dossierinfo"></div>
</header>

<section class="login" id="login" hidden>
  <div class="k" style="color:var(--soft);font-weight:600;font-size:14px">Plantekenaar</div>
  <h1>Teken je plan</h1>
  <p class="uitleg">Vul je dossiernummer en e-mailadres in. Je vindt ze in onze bevestigingsmail.</p>
  <label for="l-id">Dossiernummer<input id="l-id" placeholder="EV-261101-ABCD" autocomplete="off"></label>
  <label for="l-mail">E-mail<input id="l-mail" type="email" autocomplete="email"></label>
  <p class="err" id="l-err" hidden></p>
  <button class="btn primary" id="l-go" type="button">Openen</button>
  <button class="btn" id="l-demo" type="button">Eerst de demo bekijken</button>
</section>

<div class="app" id="app" hidden>
  <aside class="side">
    <p class="nodig" id="nodig"></p>
    <div class="steps" id="steps"></div>
    <div><div class="stapnr" id="stapnr"></div><h1 id="staptitel"></h1></div>
    <p class="uitleg" id="stapuitleg"></p>
    <div id="stapvelden"></div>
    <div id="lijstwrap"><div class="lijst" id="lijst"></div><div id="edit" style="margin-top:10px"></div></div>
    <div id="checkwrap"><ul class="checks" id="checks"></ul></div>
    <div id="opslaanwrap" hidden></div>
    <p class="melding" id="msg"></p>
    <div class="nav"><button class="btn" id="terug" type="button">Vorige</button><button class="btn primary" id="verder" type="button">Volgende</button></div>
  </aside>
  <div class="stage">
    <div class="tools" id="tools"></div>
    <div id="map"></div>
    <div id="gp" hidden></div>
    <div class="banner" id="banner" hidden></div>
  </div>
</div>

<script is:inline src="/vendor/leaflet-1.9.4/leaflet.js"></script>
<script is:inline src="/vendor/jspdf-2.5.1.umd.min.js"></script>
<script is:inline src="/plan/tekenaar.js"></script>
</body>
</html>
