---
// Gemeenschappelijke kop, menu en voet voor alle pagina's.
interface Props {
  title: string;
  description: string;
  canonical?: string;   // pad, bv. "/oostende/"
  home?: boolean;       // startpagina: ankers zonder "/" ervoor
  toonStart?: boolean;  // knop "Start" in het menu
  startHref?: string;
}
const { title, description, canonical, home = false, toonStart = true, startHref = "/aanvraag" } = Astro.props;
const DOMEIN = "https://evenementaanvragen.be";
const p = home ? "" : "/";
// Lettertypes van de eigen server (geen verzoek naar Google Fonts).
import "@fontsource/unbounded/600.css";
import "@fontsource/unbounded/800.css";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import "@fontsource/instrument-sans/700.css";
---
<!doctype html>
<html lang="nl-BE">
<head>
<meta charset="utf-8">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
{canonical && <link rel="canonical" href={DOMEIN + canonical}>}
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#1a1d2b">
<meta property="og:type" content="website">
<meta property="og:site_name" content="evenementaanvragen.be">
<meta property="og:locale" content="nl_BE">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{canonical && <meta property="og:url" content={DOMEIN + canonical}>}
<meta property="og:image" content={DOMEIN + "/deelbeeld.jpg"}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Jij maakt het feest. Wij regelen de aanvraag.">
<meta name="twitter:card" content="summary_large_image">
<slot name="head" />
</head>
<body>

<header class="top"><div class="wrap">
  <a class="mark" href={home ? "#top" : "/"} aria-label={home ? "evenementaanvragen.be, naar boven" : "evenementaanvragen.be, naar de startpagina"}>evenementaanvragen<b>.be</b></a>
  <nav class="menu" aria-label="Hoofdmenu">
    <a href={p + "#werkwijze"}>Werkwijze</a><a href={p + "#prijzen"}>Prijzen</a><a href={p + "#vragen"}>Vragen</a>{toonStart && <a class="go" href={startHref}>Start</a>}
  </nav>
</div></header>

<slot />

<footer class="foot"><div class="wrap">
  <div><b>evenementaanvragen.be</b>Troostberg<br>Zwanenlaan 45, 8400 Oostende<br>Ondernemingsnummer 0791.797.538</div>
  <div><b>Contact</b>thomas@evenementaanvragen.be<br><br><a href="/gemeenten/">Alle gemeenten</a></div>
  <div><b>Juridisch</b><a href="/voorwaarden">Algemene voorwaarden</a><br><a href="/privacy">Privacyverklaring</a></div>
</div></footer>

<slot name="scripts" />
</body>
</html>
